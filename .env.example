# Secrets — never commit this file (see .gitignore)
KLING_API_KEY=

# Optional: official Kling (klingai.com) uses an AccessKey/SecretKey pair signed
# into a JWT. If you have a pair, set these two instead of / in addition to the
# single key above and set video.auth_mode: jwt in config.yaml.
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=

# Optional: used by the script-breakdown / character-bible steps (Claude API).
# ANTHROPIC_API_KEY=

# Optional: only needed by non-default image providers.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# HF_API_TOKEN=
